# Environment Configuration Template
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-key-example
SITE_URL=http://127.0.0.1:8000

# Supabase Auth & Backend Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY is optional for server-side management; NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (Supabase PostgreSQL or local SQLite)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Google Gemini AI API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Crowd Heatmap <noreply@crowdheatmap.local>

# OpenStreetMap / Overpass (optional)
# Comma-separated Overpass mirrors, tried in order with hedging. A private or
# paid instance gives predictable latency (public servers are often overloaded).
OVERPASS_URLS=
# Seconds one web request waits for OpenStreetMap before answering "still fetching".
OVERPASS_WAIT_SECONDS=18
# Where the OpenStreetMap area cache is stored (default: .cache/overpass in the project).
OVERPASS_CACHE_DIR=
# Area data counts as fresh for this many seconds (then served while refreshing).
OVERPASS_FRESH_SECONDS=600
# Seconds between live revenue pushes on ws/analytics/.
ANALYTICS_LIVE_INTERVAL=5
