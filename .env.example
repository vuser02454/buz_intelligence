# Environment Configuration Template
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-key-example
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.5-flash

# Email / SMTP Configuration (e.g. Resend / Gmail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-api-key-or-smtp-password
DEFAULT_FROM_EMAIL=Crowd Heatmap <onboarding@resend.dev>
EMAIL_VERIFICATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=86400
